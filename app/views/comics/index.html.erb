<p style="color: green"><%= notice %></p>

<h1>一覧</h1>

<div>
  <%= link_to "新しい書籍の追加", new_comic_path %>
  &nbsp;&nbsp;&nbsp;
  <%= link_to "タイトルに戻る", start_index_path %>
  &nbsp;&nbsp;&nbsp;
  <%=link_to "コピーページにアクセス",titles_index_path%>
</div>

<br>

<%= form_tag(comics_path, method: 'get') do %>
  <%= label_tag(:title_key, 'タイトルの検索') %>
  <%= text_field_tag(:title_key, params[:title_key]) %>
  <div>
    <%= label_tag(:conclusion, '完結', for: 'conclusion_true') %>
    <%= radio_button_tag(:conclusion, 'true', params[:conclusion] == 'true', id: 'conclusion_true') %>
    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    <%= label_tag(:conclusion, '未完結', for: 'conclusion_false') %>
    <%= radio_button_tag(:conclusion, 'false', params[:conclusion] == 'false', id: 'conclusion_false') %>
  </div>

  <%= submit_tag('検索') %>&nbsp;&nbsp;<%= link_to 'クリア',comics_path%>
<% end %>

<hr class="custom-line">
<strong>合計冊数:</strong><%=total_books%>冊&nbsp;&nbsp;<strong>合計タイトル:</strong><%=total_titles%>
<br>
<table>
  <thead>
    <tr>
      <th style="text-align: center;">完結</th>
      <th>タイトル</th>
      <th style="text-align: center;">所持巻数</th>
      <th style="text-align: center;">未所持冊数</th>
      <th colspan="4"></th>
      <th>最終更新日</th>
    </tr>
  </thead>

  <tbody>
    <% @comics.each do |comic| %>
      <tr>
        <td style="text-align: center;"><%="●" if comic.conclusion%></td>
        <td><%= comic.title %></td>
        <td style="text-align: center;">
          <%= comic.start_volume if comic.start_volume%>
          <%= "巻" if comic.start_volume%>
          <%= "~" if comic.start_volume&&comic.end_volume%>
          <%= comic.end_volume if comic.end_volume%>
          <%= "巻" if comic.end_volume%>
        </td>
        <td style="text-align: center;">
          <%= comic.nonpossession %>
          <%= "冊" if comic.nonpossession%>
        </td>
        <td>
        <td><%= link_to '詳細', comic %></td>
        <td><%= link_to '編集', edit_comic_path(comic) ,style: 'margin-right: 30px;' %></td>
        <td><%= link_to '削除', comic, data: { turbo_method: :delete, turbo_confirm: "「#{comic.title}」を削除しますか？"} %></td>
        <td><%= comic.last_update.in_time_zone('Asia/Tokyo').strftime("%Y年%m月%d日%H時%M分%S秒") if comic.last_update!=nil%></td>
</td>
      </tr>
    <% end %>
  </tbody>
</table>

